{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "pharmacy-inventory",
    "version": "1.0.0",
    "description": "Pharmacy Inventory Management System",
    "private": true,
    "type": "module",
    "main": "electron/main.js",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "electron": "electron .",
        "electron-dev": "concurrently \"php artisan serve\" \"npm run dev\" \"wait-on http://127.0.0.1:8000 && electron .\"",
        "dist": "npm run build && electron-builder"
    },
"build": {
    "appId": "com.pharmacy.inventory",
    "productName": "Pharmacy Inventory",
    "publish": null,
    "copyright": "Copyright © 2026",

    "asar": false,

    "directories": {
        "output": "dist",
        "buildResources": "build"
    },

    "files": [
        "electron/**/*",
        "package.json"
    ],

    "extraResources": [
        {
            "from": ".",
            "to": "app",
            "filter": [
                "app/**",
                "bootstrap/**",
                "config/**",
                "database/**",
                "public/**",
                "resources/**",
                "routes/**",
                "runtime/**",
                "storage/**",
                "vendor/**",
                "artisan",
                "composer.json",
                "composer.lock",
                ".env"
            ]
        }
    ],

    "win": {
    "target": [
        {
            "target": "nsis",
            "arch": [
                "x64"
            ]
        }
    ],
    "icon": "build/icon.ico"
},

    "nsis": {
        "oneClick": false,
        "allowToChangeInstallationDirectory": true,
        "createDesktopShortcut": true,
        "createStartMenuShortcut": true,
        "shortcutName": "Pharmacy Inventory"
    }
},
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.2",
        "@tailwindcss/vite": "^4.0.0",
        "alpinejs": "^3.4.2",
        "autoprefixer": "^10.4.2",
        "axios": "^1.11.0",
        "concurrently": "^9.2.4",
        "electron": "^43.2.0",
        "electron-builder": "^26.15.3",
        "laravel-vite-plugin": "^2.0.0",
        "postcss": "^8.4.31",
        "tailwindcss": "^3.1.0",
        "vite": "^7.0.7",
        "wait-on": "^9.1.0"
    }
}
